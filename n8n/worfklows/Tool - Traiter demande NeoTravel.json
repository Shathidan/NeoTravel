    {
      "parameters": {
        "jsCode": "const demande = $(\"Prep_Airtable\").first().json;\nconst airtableDemande = $(\"Creer_Demande\").first().json;\n\nconst distanceKm = Number(demande.distanceKm);\nconst passagers = Number(demande.nombrePassagersAirtable || demande.nombrePassagers);\nconst typeTrajet = demande.typeTrajet || \"aller_simple\";\nconst dateDepart = new Date(demande.dateDepartAirtable || demande.dateDepart);\n\nconst tarifs = [\n  { max: 10, prix: 250 },\n  { max: 20, prix: 250 },\n  { max: 30, prix: 250 },\n  { max: 40, prix: 320 },\n  { max: 50, prix: 350 },\n  { max: 60, prix: 390 },\n  { max: 70, prix: 430 },\n  { max: 80, prix: 500 },\n  { max: 90, prix: 540 },\n  { max: 100, prix: 580 },\n  { max: 110, prix: 620 },\n  { max: 120, prix: 660 },\n  { max: 130, prix: 700 },\n  { max: 140, prix: 740 },\n  { max: 150, prix: 780 },\n  { max: 160, prix: 820 },\n  { max: 170, prix: 860 },\n  { max: 180, prix: 900 }\n];\n\nlet prixBase = 0;\n\nif (distanceKm <= 180) {\n  const ligne = tarifs.find(t => distanceKm <= t.max);\n  prixBase = ligne ? ligne.prix : 900;\n} else {\n  prixBase = (distanceKm * 2) * 2.5;\n}\n\nif (typeTrajet === \"aller_retour\") {\n  prixBase = prixBase * 2;\n}\n\n// Coefficient capacité\nlet coeffCapacite = 0;\n\nif (passagers <= 19) {\n  coeffCapacite = -5;\n} else if (passagers <= 53) {\n  coeffCapacite = 0;\n} else if (passagers <= 63) {\n  coeffCapacite = 15;\n} else if (passagers <= 67) {\n  coeffCapacite = 20;\n} else if (passagers <= 85) {\n  coeffCapacite = 40;\n} else {\n  return [\n    {\n      json: {\n        ...demande,\n        demandeRecordId: airtableDemande.id,\n        calculPossible: false,\n        interventionHumaine: true,\n        messageClient: \"Votre demande concerne plus de 85 passagers. Un commercial va reprendre votre dossier.\"\n      }\n    }\n  ];\n}\n\n// Coefficient saisonnalité\nconst mois = dateDepart.getMonth() + 1;\nlet coeffSaison = 0;\n\nif ([11, 1, 2, 8].includes(mois)) {\n  coeffSaison = -7;\n} else if ([12, 10, 9].includes(mois)) {\n  coeffSaison = 0;\n} else if ([3, 4, 7].includes(mois)) {\n  coeffSaison = 10;\n} else if ([5, 6].includes(mois)) {\n  coeffSaison = 15;\n}\n\n// Coefficient urgence\nconst aujourdHui = new Date();\n\nconst joursAvantDepart = Math.ceil(\n  (dateDepart.getTime() - aujourdHui.getTime()) / (1000 * 60 * 60 * 24)\n);\n\nlet coeffUrgence = 0;\n\nif (joursAvantDepart <= 14) {\n  coeffUrgence = 10;\n} else if (joursAvantDepart <= 30) {\n  coeffUrgence = 5;\n} else if (joursAvantDepart <= 90) {\n  coeffUrgence = -5;\n} else {\n  coeffUrgence = -10;\n}\n\n// Marge + TVA\nconst marge = 15;\nconst tva = 10;\n\nconst coefficientTotal = coeffCapacite + coeffSaison + coeffUrgence;\n\nconst montantApresCoeff = prixBase * (1 + coefficientTotal / 100);\nconst montantHT = montantApresCoeff * (1 + marge / 100);\nconst montantTTC = montantHT * (1 + tva / 100);\n\nreturn [\n  {\n    json: {\n      ...demande,\n      demandeRecordId: airtableDemande.id,\n      calculPossible: true,\n      prixBase: Math.round(prixBase),\n      coeffCapacite,\n      coeffSaison,\n      coeffUrgence,\n      coefficientTotal,\n      marge,\n      tva,\n      montantHT: Math.round(montantHT),\n      montantTTC: Math.round(montantTTC),\n      devise: \"EUR\",\n      joursAvantDepart,\n      messageClient: `Votre devis estimatif est de ${Math.round(montantTTC)} € TTC.`\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
