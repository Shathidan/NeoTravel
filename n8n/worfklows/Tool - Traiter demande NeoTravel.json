        "jsCode": "let data = $json;\n\n// Selon la façon dont l'agent appelle le tool, les données peuvent être directes ou encapsulées\nif (data.input) data = data.input;\nif (data.arguments) data = data.arguments;\nif (data.query) data = data.query;\n\nif (typeof data === \"string\") {\n  try {\n    data = JSON.parse(data);\n  } catch (error) {\n    data = {};\n  }\n}\n\nreturn [\n  {\n    json: {\n      nom: data.nom || \"\",\n      email: data.email || \"\",\n      telephone: data.telephone || \"\",\n      destination: data.destination || \"\",\n      dateDepart: data.dateDepart || \"\",\n      nombrePassagers: Number(data.nombrePassagers || 0),\n      distanceKm: Number(data.distanceKm || 0),\n      typeTrajet: data.typeTrajet || \"aller_simple\",\n      interventionHumaine: Boolean(data.interventionHumaine),\n      resume: data.resume || \"\",\n      categorie: data.categorie || \"Transfert\"\n    }\n  }\n];"
