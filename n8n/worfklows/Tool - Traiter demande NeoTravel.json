      "parameters": {
        "jsCode": "const calcul = $(\"Calcul_Devis\").first().json;\nconst demande = $(\"Creer_Demande\").first().json;\nconst devis = $(\"Creer_Devis\").first().json;\nconst relance = $(\"Creer_Relance\").first().json;\nconst pdfData = $(\"Preparer_URL_PDF\").first().json;\n\nreturn [\n  {\n    json: {\n      success: true,\n      message: calcul.messageClient,\n      demandeId: demande.id,\n      devisId: devis.id,\n      relanceId: relance.id,\n      pdfUrl: pdfData.pdfUrl,\n      client: calcul.nom,\n      email: calcul.email,\n      destination: calcul.destination,\n      dateDepart: calcul.dateDepart,\n      nombrePassagers: calcul.nombrePassagers,\n      distanceKm: calcul.distanceKm,\n      typeTrajet: calcul.typeTrajet,\n      prixBase: calcul.prixBase,\n      montantHT: calcul.montantHT,\n      montantTTC: calcul.montantTTC,\n      devise: calcul.devise,\n      interventionHumaine: calcul.interventionHumaine,\n      resume: calcul.resume\n    }\n  }\n];"
